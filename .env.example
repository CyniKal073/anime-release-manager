# nekoBT：公开检索不需要 Key；仅非公开种子（private_magnet）才需要
NEKOBT_API_KEY=

# qBittorrent WebUI（需先在客户端里启用 WebUI 并设置账号密码）
QBIT_URL=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=
QBIT_SAVEPATH=D:\Anime\library
QBIT_CATEGORY=anime
QBIT_TAGS=nekobt
# 下载时若 qBittorrent 未运行，尝试启动这个可执行文件（留空则只报错不启动）
QBIT_EXECUTABLE=F:\qBittorrentEE\qbittorrent_x64.exe

HTTP_TIMEOUT=20
HTTP_RETRIES=3
